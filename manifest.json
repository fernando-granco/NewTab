{
  "manifest_version": 3,
  "name": "New Tab",
  "description": "A premium, highly customizable New Tab extension with a sleek design, shortcut management, and integrated search.",
  "version": "1.2.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "bookmarks",
    "search",
    "favicon"
  ],
  "host_permissions": [
    "https://t2.gstatic.com/faviconV2*",
    "https://cdn.jsdelivr.net/*"
  ]
}
